# ---- Chain / network (optional; sensible defaults for Mantle Sepolia) ----
NEXT_PUBLIC_CHAIN_ID=5003
NEXT_PUBLIC_MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.mantlescan.xyz

# ---- Deployed contract addresses ----
# Required for the real on-chain lifecycle. `npm run deploy:mantle` writes these
# into web/.env.local automatically. Until set, the console shows a setup screen.
NEXT_PUBLIC_AGENT_REGISTRY_ADDRESS=
NEXT_PUBLIC_DECISION_LOG_ADDRESS=
NEXT_PUBLIC_EPOCH_LOG_ADDRESS=
NEXT_PUBLIC_POLICY_VAULT_ADDRESS=
# Real execution layer: test USDC + yield vaults
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_BALANCED_VAULT_ADDRESS=
NEXT_PUBLIC_HIGH_APY_VAULT_ADDRESS=

# ---- Server-side (contracts deploy lives in /contracts, not here) ----
PRIVATE_KEY=
MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz

# ---- Optional AI enrichment (app works fully without these) ----
OPENAI_API_KEY=
BYREAL_API_KEY=
